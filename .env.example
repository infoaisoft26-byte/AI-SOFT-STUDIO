# Create a dedicated Neon database for AI SOFT STUDIO. Never reuse another project's database.
DATABASE_URL=
ADMIN_EMAIL=admin@aisoft.in
# Use a unique password of at least 12 characters; keep it only in Vercel encrypted env vars.
ADMIN_PASSWORD=
# Generate a random secret with at least 32 characters.
ADMIN_SESSION_SECRET=

# Meta WhatsApp Cloud API — keep all values in encrypted Vercel environment variables.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_AUTO_REPLY=true
WHATSAPP_AUTO_REPLY_TEXT=Thanks for contacting AI SOFT STUDIO. We received your message and our team will get back to you shortly.
WHATSAPP_GRAPH_API_VERSION=v26.0

WHATSAPP_ENQUIRY_ACK_TEMPLATE=
WHATSAPP_ENQUIRY_ACK_LANGUAGE=en
WHATSAPP_ADMIN_ALERT_TEMPLATE=
